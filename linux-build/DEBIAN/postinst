#!/bin/bash
set -e

case "$1" in
    configure)

        # Backfill @vscode/ripgrep-linux-x64 if missing from app.asar.unpacked.
        # The upstream build sometimes ships a .deb without it; the app crashes
        # on startup without this binary. Backfill from npm or fall back to
        # the system ripgrep package.
        # Stage a fallback @vscode/ripgrep-linux-x64 package that points at the
# system ripgrep. The .deb from upstream often ships without the platform
# binary; npm install of the real package sometimes fails offline. In
# either case, the @vscode/ripgrep wrapper requires the platform package
# to be resolvable via `require()`, so a bare symlink to /usr/bin/rg
# is not enough — we need the full directory structure with package.json
# and index.js exporting the binary path.
stage_ripgrep_fallback() {
    local target_dir="$1"
    if [ -d "$target_dir" ] && [ -f "$target_dir/bin/rg" ] && [ -f "$target_dir/package.json" ]; then
        return 0  # already complete
    fi
    if ! command -v rg >/dev/null 2>&1; then
        echo "minimax-agent: WARNING - system ripgrep not found; install ripgrep package" >&2
        return 1
    fi
    mkdir -p "$target_dir/bin"
    ln -sf "$(command -v rg)" "$target_dir/bin/rg"
    cat > "$target_dir/package.json" <<'PKGJSON'
{
  "name": "@vscode/ripgrep-linux-x64",
  "version": "1.0.0-system-rg",
  "description": "System ripgrep wrapper for @vscode/ripgrep on Cachy OS / Arch",
  "main": "index.js",
  "bin": { "rg": "bin/rg" }
}
PKGJSON
    cat > "$target_dir/index.js" <<'IDXJS'
// Minimal stub of @vscode/ripgrep-linux-x64 for environments where the
// real platform binary isn't shipped. Wraps the system /usr/bin/rg (or
// wherever `which rg` points) so @vscode/ripgrep's `require()` call works.
const path = require('path');
const rgPath = path.join(__dirname, 'bin', 'rg');
module.exports = { path: rgPath };
module.exports.default = module.exports;
IDXJS
    echo "minimax-agent: Staged fallback @vscode/ripgrep-linux-x64 -> $(command -v rg)"
}


ASAR_UNPACKED="/opt/minimax-agent/resources/app.asar.unpacked"
        if [ -d "$ASAR_UNPACKED" ] && [ ! -d "$ASAR_UNPACKED/node_modules/@vscode/ripgrep-linux-x64" ]; then
            echo "minimax-agent: Back-filling @vscode/ripgrep-linux-x64..."
            BACKFILL_STAGE="/tmp/minimax-backfill.$$"
            mkdir -p "$BACKFILL_STAGE"
            (
                cd "$BACKFILL_STAGE"
                printf '{\n  "name": "minimax-backfill",\n  "version": "1.0.0",\n  "private": true,\n  "dependencies": { "@vscode/ripgrep": "*" }\n}\n' > package.json
                if command -v npm >/dev/null 2>&1; then
                    if npm install --no-audit --no-fund --omit=dev 2>/dev/null; then
                        mkdir -p "$ASAR_UNPACKED/node_modules/@vscode"
                        cp -a node_modules/@vscode/ripgrep-linux-x64 "$ASAR_UNPACKED/node_modules/@vscode/"
                        echo "minimax-agent: Back-filled @vscode/ripgrep-linux-x64 from npm"
                    fi
                fi
            )
            stage_ripgrep_fallback "$ASAR_UNPACKED/node_modules/@vscode/ripgrep-linux-x64" || true
            unset BACKFILL_STAGE
        fi        # ── Desktop integration ──
        if [ -x /usr/bin/update-desktop-database ]; then
            /usr/bin/update-desktop-database /usr/share/applications/ 2>/dev/null || true
        fi
        if [ -x /usr/bin/gtk-update-icon-cache ]; then
            /usr/bin/gtk-update-icon-cache /usr/share/icons/hicolor 2>/dev/null || true
        fi

        # ── Permissions ──
        if [ -f /opt/minimax-agent/chrome-sandbox ]; then
            chmod 4755 /opt/minimax-agent/chrome-sandbox 2>/dev/null || true
        fi
        if [ -d /opt/minimax-agent/resources/resources/opencode ]; then
            find /opt/minimax-agent/resources/resources/opencode -type f -exec chmod 755 {} \; 2>/dev/null || true
        fi

        # ── OAuth protocol handlers ──
        if command -v xdg-mime >/dev/null 2>&1; then
            xdg-mime default minimax-agent.desktop x-scheme-handler/minimax 2>/dev/null || true
            xdg-mime default minimax-agent.desktop x-scheme-handler/minimax-agent 2>/dev/null || true
        fi
        if command -v gio >/dev/null 2>&1; then
            gio mime x-scheme-handler/minimax minimax-agent.desktop 2>/dev/null || true
            gio mime x-scheme-handler/minimax-agent minimax-agent.desktop 2>/dev/null || true
        fi

        # ── Backend daemon setup ──
        DAEMON_DIR="/opt/minimax-agent/resources/resources/daemon"
        if command -v node >/dev/null 2>&1; then
            NODE_VER=$(node --version)
            echo "minimax-agent: Node.js $NODE_VER detected."

            # Verify native daemon modules and rebuild if needed
            if [ -d "$DAEMON_DIR/node_modules" ]; then
                NEED_REBUILD=false
                node -e "require('better-sqlite3')" 2>/dev/null || NEED_REBUILD=true
                node -e "require('fs-native-extensions')" 2>/dev/null || NEED_REBUILD=true
                if $NEED_REBUILD && command -v npm >/dev/null 2>&1; then
                    echo "minimax-agent: Rebuilding native modules for $NODE_VER..."
                    cd "$DAEMON_DIR" && npm rebuild 2>&1 && \
                        echo "minimax-agent: Native modules rebuilt." || \
                        echo "minimax-agent: WARNING - npm rebuild failed. Run manually: cd $DAEMON_DIR && npm rebuild"
                fi
            fi
        else
            echo "WARNING: minimax-agent -- Node.js not found."
            echo "  The backend daemon requires Node.js >= 18."
            echo "  Install it: sudo apt install nodejs"
            echo "  Or use nvm: https://github.com/nvm-sh/nvm"
        fi

        # Prepare backend daemon directories for every human user
        SYSTEMD_ACTIVE=false
        if command -v loginctl >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1 && [ "$(ps -p 1 -o comm= 2>/dev/null)" = "systemd" ]; then
            SYSTEMD_ACTIVE=true
        fi

        for entry in $(getent passwd 2>/dev/null | awk -F: '$3 >= 1000 && $3 < 65534 && $7 !~ /nologin|false/ {print $1":"$6}'); do
            user="${entry%%:*}"
            home="${entry#*:}"
            if [ -z "$user" ] || [ "$user" = "root" ]; then
                continue
            fi

            # Enable linger so systemctl --user works after logout
            if $SYSTEMD_ACTIVE; then
                loginctl enable-linger "$user" 2>/dev/null || true
            fi

            # Handle broken symlink at ~/.mavis (from previous installations)
            if [ -L "$home/.mavis" ] && [ ! -e "$home/.mavis" ]; then
                rm -f "$home/.mavis" 2>/dev/null || true
            fi

            # Pre-create daemon directories
            mkdir -p "$home/.mavis/logs" 2>/dev/null || true
            mkdir -p "$home/.mavis/screenshots" 2>/dev/null || true

            # Fix ownership if we created dirs as root
            chown "$user:$user" "$home/.mavis" 2>/dev/null || true
            chown -R "$user:$user" "$home/.mavis/logs" "$home/.mavis/screenshots" 2>/dev/null || true
        done
        ;;
esac

exit 0
